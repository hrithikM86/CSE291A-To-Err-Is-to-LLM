        return -1
    
    # If x > y, return -1
    if x > y:
        return -1
    
    # Find the smallest even number in the range
    if x % 2 == 0:
        smallest_even = x
    else:
        smallest_even = x + 1
    
    # Check if the smallest even number is within the range
    if smallest_even <= y:
        return smallest_even
    else:
        return -1
