    if n < 1 or n > 10000:
        return False
    
    # Edge Cases
    if n < 8 or n % 2 != 0:
        return False
    
    # General Case
    if n == 8:
        return True
    elif n % 4 != 0:
        return False
    
    # Boundary Conditions
    return True
