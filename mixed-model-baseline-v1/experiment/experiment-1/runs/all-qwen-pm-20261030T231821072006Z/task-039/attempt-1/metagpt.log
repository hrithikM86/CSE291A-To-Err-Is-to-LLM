 than 0.\\")\\n    if n > 20:\\n        raise ValueError(\\"Input must be less than or equal to 20.\\")\\n\\n    fibonacci = []\\n    a, b = 0, 1\\n    count = 0\\n\\n    while count < n + 1:\\n        if is_prime(b):\\n            fibonacci.append(b)\\n            count += 1\\n        a, b = b, a + b\\n\\n    return fibonacci[n]\\n\\n# Test cases\\nprint(prime_fib(1))  # 2\\nprint(prime_fib(2))  # 3\\nprint(prime_fib(3))  # 5\\nprint(prime_fib(4))  # 13\\nprint(prime_fib(5))  # 89\\n```"}'}]
