def will_it_fly(q, w):
    # Function to check if the list is a palindrome
    def is_palindrome(lst):
        return lst == lst[::-1]
    
    # Check if the list is empty
    if not q:
        return False
    
    # Check if the list is a palindrome
    if not is_palindrome(q):
        return False
    
    # Calculate the sum of the elements in the list
    total_weight = sum(q)
    
