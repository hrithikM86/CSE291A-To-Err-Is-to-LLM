```python
def is_prime(n):
    if n <= 1:
        return False
    if n <= 3:
        return True
    if n % 2 == 0 or n % 3 == 0:
        return False
    i = 5
    while i * i <= n:
        if n % i == 0 or n % (i + 2) == 0:
            return False
        i += 6
    return True

def intersection(interval1, interval2):
    start1, end1 = interval1
    start2, end2 = interval2
    
    start = max(start1, start2)
    end = min(end1, end2)
    
    if start > end:
        return "NO"
    
    length = end - start + 1
    
    if is_prime(length):
        return "YES"
    else:
        return "NO"

# Test cases
print(intersection((1, 2), (2, 3)))  # NO
print(intersection((-1, 1), (0, 4)))  # NO
print(intersection((-3, -1), (-5, 5)))  # YES
```
