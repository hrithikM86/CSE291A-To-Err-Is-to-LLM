 != 0:\\n            odd_numbers.append(current)\\n        current = current // 2 if current % 2 == 0 else 3 * current + 1\\n    \\n    if 1 not in odd_numbers:\\n        odd_numbers.append(1)\\n    \\n    odd_numbers.sort()\\n    return odd_numbers\\n```"}'}]
