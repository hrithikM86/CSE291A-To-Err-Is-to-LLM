```python
def int_to_mini_roman(number: int) -> str:
    roman_map = {1000: 'm', 900: 'cm', 500: 'd', 400: 'cd', 100: 'c', 90: 'xc', 50: 'l', 40: 'xl', 10: 'x', 9: 'ix', 5: 'v', 4: 'iv', 1: 'i'}
    result = ''
    for key in sorted(roman_map.keys(), reverse=True):
        while number >= key:
            result += roman_map[key]
            number -= key
    return result.lower()
```
