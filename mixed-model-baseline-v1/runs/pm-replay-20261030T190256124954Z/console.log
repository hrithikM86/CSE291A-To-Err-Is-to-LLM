def add(lst):
    """
    Given a non-empty list of integers lst. add the even elements that are at odd indices.
    
    Examples:
        add([4, 2, 6, 7]) ==> 2 
    """
    if not lst:
        raise ValueError("The list cannot be empty")

    sum_even = 0

    for i in range(1, len(lst), 2):
        if lst[i] % 2 == 0:
            sum_even += lst[i]

    return sum_even
