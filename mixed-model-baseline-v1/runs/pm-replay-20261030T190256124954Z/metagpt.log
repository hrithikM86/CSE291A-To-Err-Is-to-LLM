nt_lst2 = sum(1 for x in lst2 if x % 2 == 0)\\n    \\n    # Return \\"YES\\" only when the counts are equal\\n    return \\"YES\\" if odd_count_lst1 == even_count_lst2 else \\"NO\\"\\n```"}'}]
