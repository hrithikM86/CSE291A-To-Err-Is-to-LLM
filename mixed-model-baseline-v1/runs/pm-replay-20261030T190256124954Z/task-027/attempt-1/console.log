def flip_case(string: str) -> str:
    if not string:
        return ""
    
    result = []
    for char in string:
        if char.islower():
            result.append(char.upper())
        elif char.isupper():
            result.append(char.lower())
        else:
            result.append(char)
    
    return ''.join(result)
