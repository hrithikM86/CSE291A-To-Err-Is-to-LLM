```python
def fib(n: int) -> int:
    if n < 1:
        raise ValueError("Input must be a positive integer")
    if n == 1:
        return 1
    if n == 2:
        return 1
    
    memo = [0] * (n + 1)
    memo[1], memo[2] = 1, 1
    
    for i in range(3, n + 1):
        memo[i] = memo[i - 1] + memo[i - 2]
    
    return memo[n]
```
