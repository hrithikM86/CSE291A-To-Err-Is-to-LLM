```python
def starts_one_ends(n: int) -> int:
    """
    Given a positive integer n, return the count of the numbers of n-digit
    positive integers that start or end with 1.
    """
    if n < 1:
        raise ValueError("Input must be a positive integer")
    
    if n == 1:
        return 1
    
    # Count numbers that start with 1
    start_with_1 = 10 ** (n - 1)
    
    # Count numbers that end with 1
    end_with_1 = 10 ** (n - 1)
    
    # Subtract the count of numbers that both start and end with 1 to avoid double counting
    both_start_and_end_with_1 = 10 ** (n - 2)
    
    return start_with_1 + end_with_1 - both_start_and_end_with_1
```
